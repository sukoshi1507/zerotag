#!/bin/sh
# SPDX-License-Identifier: MIT
# Loads the device-tree overlay that exposes /dev/spidev0.2, the SPI port of the Cap CC1101 (ST25R3916 NFC).
# It needs root and is lost at reboot, so run it once after each boot before using ZeroTag:
#
#     sudo /usr/lib/zerotag/cap-setup
OVERLAY=spi0-spidev2-gpio22-overlay
NODE=/dev/spidev0.2

if [ "$(id -u)" -ne 0 ]; then
    echo "cap-setup needs root: sudo $0" >&2
    exit 1
fi

if [ -e "$NODE" ]; then
    echo "$NODE is already available."
    exit 0
fi

if ! dtoverlay -l 2>/dev/null | grep -q "$OVERLAY"; then
    dtoverlay "$OVERLAY" || { echo "could not load the $OVERLAY overlay" >&2; exit 1; }
fi

# udev creates the node (group spi) a moment later.
i=0
while [ ! -e "$NODE" ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done

# Let udev apply the group (spi) and mode to the new node before returning.
if command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=5 2>/dev/null || true
fi

if [ -e "$NODE" ]; then
    echo "$NODE is ready."
else
    echo "the overlay is loaded but $NODE did not appear" >&2
    exit 1
fi
