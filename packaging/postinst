#!/bin/sh
set -e
# Versions up to 0.3.0 shipped a boot-time zerotag-spi.service (removed: store apps must not run root services).
# Clean up its enable link on upgrade; the overlay is now loaded with `sudo /usr/lib/zerotag/cap-setup`.
if [ "$1" = "configure" ]; then
    rm -f /etc/systemd/system/multi-user.target.wants/zerotag-spi.service
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
fi
exit 0
